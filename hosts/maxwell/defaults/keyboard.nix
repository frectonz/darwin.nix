{
  system.defaults.NSGlobalDomain = {
    # how fast a held key repeats (lower is faster)
    KeyRepeat = 2;
    # how long before a held key starts repeating (lower is sooner)
    InitialKeyRepeat = 15;
    # holding a key repeats it instead of showing the accent popup
    ApplePressAndHoldEnabled = false;
    # stop macOS from rewriting what you type
    NSAutomaticCapitalizationEnabled = false;
    NSAutomaticSpellingCorrectionEnabled = false;
    NSAutomaticPeriodSubstitutionEnabled = false;
    NSAutomaticQuoteSubstitutionEnabled = false;
    NSAutomaticDashSubstitutionEnabled = false;
  };
}
