{
  system.defaults = {
    # tap the trackpad to click
    trackpad.Clicking = true;
    NSGlobalDomain = {
      # pointer speed
      "com.apple.trackpad.scaling" = 1.0;
      # ctrl+cmd+drag moves a window from anywhere, not just the title bar
      NSWindowShouldDragOnGesture = true;
    };
  };
}
