{
  system.defaults.dock = {
    # icon size in pixels
    tilesize = 40;
    # no recent apps section on the right
    show-recents = false;
    # keep Spaces in the order you arranged them
    mru-spaces = false;
    # minimized windows go into their app icon, not a separate Dock tile
    minimize-to-application = true;
  };
}
